# Discord application credentials for the RE:WORDLE Activity backend.
# Use the same Discord application for the Activity and the bot token.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=

# Railway supplies PORT automatically in production.
PORT=3000

# Development only: bypass Discord Activity Instance API verification.
# Do not enable this in production.
ACTIVITY_SKIP_INSTANCE_VERIFY=false

# Legacy observer settings (only used by `npm run start:observer`).
CONTROL_USER_ID=
DATA_DIR=./data
