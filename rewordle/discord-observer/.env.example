# Required: Discord Bot token from Developer Portal > Bot
DISCORD_TOKEN=

# Optional: if set, only this Discord user can control !w2 commands.
# Leave blank for a private test server if you want anyone in the channel to control it.
CONTROL_USER_ID=

# Optional: directory for JSONL persistence. Railway Volume can be mounted at /data.
DATA_DIR=./data

# Optional HTTP health endpoint. Railway supplies PORT automatically.
PORT=3000
